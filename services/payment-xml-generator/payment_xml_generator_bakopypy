def build_cases(count: int) -> Dict[str, Dict[str, Any]]:
    """Return the control cases plus scalable synthetic payment lifecycles."""
    cases = dict(list(POC_CASES.items())[:count])
    for case_number in range(len(cases) + 1, count + 1):
        loan_id = f"LOAN-{case_number:06d}"
        status_roll = case_number % 20
        status = STATUS_RJCT if status_roll == 0 else STATUS_PDNG if status_roll in {7, 14} else STATUS_ACSC
        amount = random.choice([500000, 750000, 1000000, 1250000, 1500000, 2000000])
        cases[loan_id] = {
            "status": status,
            "amount": amount,
            "account": generate_phone(),
            "name": f"Synthetic Beneficiary {case_number:06d}",
            "project": PROJECT_TYPES[(case_number - 1) % len(PROJECT_TYPES)],
            "desc": "Synthetic nationwide coverage case",
        }
    return cases

