{
  "contract_version": 1,
  "name": "local_operational_core_convergence",

  "target": "local",
  "production": false,

  "desired_scope": {
    "contract": "operational_core.json",
    "service_count": 7
  },

  "deployment_semantics": {
    "preflight_required": true,
    "cdc_dormancy_required": true,
    "explicit_operational_core_required": true,
    "inspect_actual_state_before_mutation": true,
    "already_converged_is_success": true,
    "already_converged_is_noop": true,
    "blind_compose_up_prohibited": true
  },

  "current_enablement": {
    "convergence_inspection_enabled": true,
    "converged_noop_enabled": true,
    "mutation_on_drift_enabled": false
  },

  "drift_policy": {
    "missing_service": "FAIL_CLOSED",
    "stopped_service": "FAIL_CLOSED",
    "unhealthy_service": "FAIL_CLOSED",
    "unexpected_recreation": "PROHIBITED",
    "automatic_dependency_start": "PROHIBITED",
    "automatic_init_helper_execution": "PROHIBITED",
    "automatic_business_workload_execution": "PROHIBITED"
  },

  "future_mutation_command_policy": {
    "compose_up": true,
    "detached": true,
    "no_recreate": true,
    "no_dependencies": true,
    "explicit_services_only": true,
    "only_non_running_approved_services": true,
    "pull": false,
    "build": false,
    "remove_orphans": false
  },

  "protected_operations": {
    "payment_producer_execution": false,
    "init_helper_execution": false,
    "cdc_activation": false,
    "kafka_offset_reset": false,
    "raw_deletion": false,
    "token_link_rematerialisation": false,
    "gate3_recovery": false,
    "terraform_apply": false
  }
}
