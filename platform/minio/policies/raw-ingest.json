{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListScopedPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/v2",
            "raw/v2/*"
          ]
        }
      }
    },
    {
      "Sid": "ObjectAccess1",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment/raw/v2/*"
      ]
    }
  ]
}
