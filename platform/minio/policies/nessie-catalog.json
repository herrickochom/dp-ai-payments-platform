{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketAccessForCatalogHealth",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment"
      ]
    },
    {
      "Sid": "ObjectAccess1",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment/warehouse/*"
      ]
    }
  ]
}
