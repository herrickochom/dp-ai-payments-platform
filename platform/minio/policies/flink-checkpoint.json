{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFlinkCheckpointPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "flink/checkpoints",
            "flink/checkpoints/*",
            "flink/savepoints",
            "flink/savepoints/*"
          ]
        }
      }
    },
    {
      "Sid": "FlinkCheckpointObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment/flink/checkpoints/*"
      ]
    },
    {
      "Sid": "FlinkSavepointObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dp-ai-payment/flink/savepoints/*"
      ]
    }
  ]
}
