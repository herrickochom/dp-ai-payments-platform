{
  "catalogs": [
    {
      "catalog": "iceberg",
      "allow": "all"
    }
  ],
  "schemas": [
    {
      "schema": ".*",
      "owner": false
    }
  ],
  "tables": [
    {
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE"]
    }
  ],
  "sessions": [
    {
      "user": ".*",
      "groups": [".*"]
    }
  ]
}
