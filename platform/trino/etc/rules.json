{
  "catalogs": [
    {
      "user": ".*",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "user": ".*",
      "catalog": "system",
      "allow": "read-only"
    }
  ],

  "schemas": [
    {
      "user": ".*",
      "catalog": "iceberg",
      "schema": ".*",
      "owner": true
    }
  ],

  "tables": [
    {
      "user": ".*",
      "catalog": "iceberg",
      "schema": ".*",
      "table": ".*",
      "privileges": [
        "SELECT",
        "INSERT",
        "DELETE",
        "UPDATE",
        "OWNERSHIP"
      ]
    },
    {
      "user": ".*",
      "catalog": "system",
      "schema": ".*",
      "table": ".*",
      "privileges": [
        "SELECT"
      ]
    }
  ],

  "system_session_properties": [
    {
      "user": ".*",
      "property": ".*",
      "allow": true
    }
  ]
}
