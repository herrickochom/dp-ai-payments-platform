# Production/managed-Kafka template. Do not use these HA values with local one-broker Kafka.
KAFKA_BOOTSTRAP_SERVERS=broker-a:9093,broker-b:9093,broker-c:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=replace-me
KAFKA_SASL_PASSWORD=replace-me
KAFKA_SSL_CA_LOCATION=/run/secrets/kafka-ca.pem
KAFKA_SSL_CERTIFICATE_LOCATION=/run/secrets/kafka-client.pem
KAFKA_SSL_KEY_LOCATION=/run/secrets/kafka-client.key
SCHEMA_REGISTRY_URL=https://schema-registry.example.invalid
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=replace-me:replace-me
TOPIC_REPLICATION_FACTOR_OVERRIDE=3
# Broker-side: default.replication.factor=3, offsets.topic.replication.factor=3,
# transaction.state.log.replication.factor=3, transaction.state.log.min.isr=2,
# and min.insync.replicas=2.
