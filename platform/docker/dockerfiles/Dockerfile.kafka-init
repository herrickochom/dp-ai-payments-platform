FROM python:3.11-slim

# Install required OS utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        jq \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir pyyaml

# Copy Kafka CLI tools from Confluent image
COPY --from=confluentinc/cp-kafka:latest \
    /usr/bin/kafka-topics \
    /usr/bin/kafka-topics

COPY --from=confluentinc/cp-kafka:latest \
    /usr/bin/kafka-configs \
    /usr/bin/kafka-configs

# Copy init script and config
COPY platform/kafka/create-topics.sh /app/create-topics.sh
COPY platform/kafka/topics.yaml /app/topics.yaml

RUN chmod +x /app/create-topics.sh

ENTRYPOINT ["/app/create-topics.sh"]