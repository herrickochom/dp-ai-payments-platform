FROM apache/superset:latest

USER root

RUN . /app/.venv/bin/activate && \
    uv pip install \
        psycopg2-binary \
        "trino[sqlalchemy]" \
        redis

COPY platform/superset/superset_config.py \
    /app/pythonpath/superset_config.py

RUN chown superset:superset \
    /app/pythonpath/superset_config.py

USER superset

EXPOSE 8088