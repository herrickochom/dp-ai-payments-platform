FROM ghcr.io/projectnessie/nessie:0.108.4

# Copy custom configuration
COPY platform/nessie/config/application.properties /app/config/application.properties

# Nessie HTTP + PostgreSQL persistence
ENV QUARKUS_HTTP_PORT=19120 \
    QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/nessie

EXPOSE 19120