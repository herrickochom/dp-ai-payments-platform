FROM python:3.11-slim

COPY services/agent-api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

WORKDIR /app
COPY services/agent-api/ /app/
COPY services/shared/security/__init__.py /app/services/shared/security/__init__.py
COPY services/shared/security/runtime_security.py /app/services/shared/security/runtime_security.py
COPY transform/dbt/models/ /app/dbt-models/

ENV AGENT_API_PORT=7010 PYTHONUNBUFFERED=1
EXPOSE 7010

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${AGENT_API_PORT}"]
