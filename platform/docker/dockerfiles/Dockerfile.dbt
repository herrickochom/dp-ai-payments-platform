FROM python:3.11-slim

# System dependencies required by dbt
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade packaging tools
RUN pip install --no-cache-dir --upgrade \
    pip \
    setuptools \
    wheel

# Shared runtime dependencies first
COPY services/shared/requirements-runtime.txt /tmp/requirements.txt

RUN pip install --no-cache-dir \
    -r /tmp/requirements.txt

# dbt core + adapters used by this platform
RUN pip install --no-cache-dir --upgrade \
    dbt-core \
    dbt-duckdb \
    dbt-trino \
    dbt-postgres \
    "typing_extensions>=4.14"

WORKDIR /usr/app/dbt

COPY platform/entrypoints/dbt-docker-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

CMD ["build"]