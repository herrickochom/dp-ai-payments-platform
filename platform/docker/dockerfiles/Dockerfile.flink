# ==============================================================================
# Apache Flink — PDM streaming route
# ==============================================================================
# Pinned release for reproducible builds. Avoid :latest in a controlled stack.
#
# Scope: STR-002B / B1.
#
# This image adds:
#   - Python 3 and PyFlink (for job development)
#   - A `python` symlink to `python3` (PyFlink invokes `python` literally)
#   - The Flink S3 filesystem plugin (from the base image's opt/ directory)
#   - The Flink Prometheus metrics reporter (fetched from Maven Central)
#   - The Flink Kafka SQL connector (fetched from Maven Central)
#   - The Flink Avro Confluent Registry format (shaded, fetched from Maven
#     Central). It provides the 'avro-confluent' table format, which decodes
#     Confluent wire-format Avro messages inside Flink. The job never touches
#     org.apache.avro from Python.
#
# Classpath rules (each one has caused an outage during STR-002B):
#   - Do NOT add a standalone Apache Avro core JAR or any Jackson JAR to
#     /opt/flink/lib. They shadow Flink's internally bundled classes and
#     prevent JobManager startup with NoClassDefFoundError: ProcessMemorySpec.
#   - Do NOT add flink-avro or the thin flink-avro-confluent-registry JAR.
#     The shaded SQL format JAR already provides the Avro format. Keeping the
#     thin copies registers duplicate format factories.
#   - Do NOT use /opt/flink/usrlib or pipeline.jars for this route. Format
#     dependencies come from the shaded JAR in lib/.
#
# It does NOT add:
#   - Any secret value
# ==============================================================================

FROM flink:1.18.1-scala_2.12-java17

# Pinned versions. Must match the Flink distribution.
ARG FLINK_VERSION=1.18.1
ARG KAFKA_CONNECTOR_VERSION=3.1.0-1.18

USER root

# ------------------------------------------------------------------------------
# System packages
# ------------------------------------------------------------------------------
# Python is needed for PyFlink. curl is used for Maven downloads below. The
# `python` symlink is required because PyFlink's driver invokes `python`
# (no version suffix), and the Debian slim base provides only `python3`.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        curl \
 && ln -sf /usr/bin/python3 /usr/local/bin/python \
 && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Python dependencies for PyFlink jobs
# ------------------------------------------------------------------------------
# requirements.txt pins apache-flink, which provides the PyFlink Table and
# DataStream APIs used by the job.
COPY platform/flink/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip \
 && python3 -m pip install --no-cache-dir -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt

# ------------------------------------------------------------------------------
# Flink plugins — S3 filesystem and Prometheus reporter
# ------------------------------------------------------------------------------
RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop \
 && cp /opt/flink/opt/flink-s3-fs-hadoop-*.jar /opt/flink/plugins/s3-fs-hadoop/ \
 && mkdir -p /opt/flink/plugins/metrics-prometheus \
 && curl --fail --silent --show-error --location --retry 3 \
        -o /opt/flink/plugins/metrics-prometheus/flink-metrics-prometheus-${FLINK_VERSION}.jar \
        "https://repo1.maven.org/maven2/org/apache/flink/flink-metrics-prometheus/${FLINK_VERSION}/flink-metrics-prometheus-${FLINK_VERSION}.jar" \
 && test -s /opt/flink/plugins/metrics-prometheus/flink-metrics-prometheus-${FLINK_VERSION}.jar

# ------------------------------------------------------------------------------
# Kafka SQL connector — required by the Table API Kafka source
# ------------------------------------------------------------------------------
RUN curl --fail --silent --show-error --location --retry 3 \
        -o /opt/flink/lib/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar \
        "https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/${KAFKA_CONNECTOR_VERSION}/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar" \
 && test -s /opt/flink/lib/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar

# ------------------------------------------------------------------------------
# Avro Confluent Registry format — shaded SQL JAR, system classpath
# ------------------------------------------------------------------------------
# Provides the 'avro-confluent' format: Confluent wire-format decoding with
# Schema Registry lookup, plus the Avro and Confluent client classes it needs,
# all relocated into a private namespace. Because the classes are shaded, the
# job reads messages through the Table API and never imports Avro from Python.
RUN curl --fail --silent --show-error --location --retry 3 \
        -o /opt/flink/lib/flink-sql-avro-confluent-registry-${FLINK_VERSION}.jar \
        "https://repo1.maven.org/maven2/org/apache/flink/flink-sql-avro-confluent-registry/${FLINK_VERSION}/flink-sql-avro-confluent-registry-${FLINK_VERSION}.jar" \
 && test -s /opt/flink/lib/flink-sql-avro-confluent-registry-${FLINK_VERSION}.jar

# ------------------------------------------------------------------------------
# Configuration and jobs
# ------------------------------------------------------------------------------
# The conf directory is COPYed at build time as a fallback. Compose must not
# mount it read-only: Flink's docker-entrypoint.sh rewrites flink-conf.yaml
# with sed -i at startup, which requires a writable conf directory.
COPY platform/flink/conf/ /opt/flink/conf/

# Jobs are baked into the image.
COPY platform/flink/jobs/ /opt/flink/jobs/

# ------------------------------------------------------------------------------
# Ownership and user
# ------------------------------------------------------------------------------
RUN chown -R flink:flink /opt/flink/conf /opt/flink/jobs /opt/flink/lib

USER flink

# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------
EXPOSE 8081 6123 9249